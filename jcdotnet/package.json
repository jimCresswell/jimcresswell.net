{
  "name": "@jimcresswell/www",
  "version": "1.1.0",
  "description": "Jim Cresswell's personal website",
  "author": {
    "name": "Jim Cresswell",
    "url": "https://www.jimcresswell.net",
    "email": "contact@jimcresswell.net"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "homepage": "https://www.jimcresswell.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/jimCresswell/jimcresswell.net.git"
  },
  "bugs": {
    "url": "https://github.com/jimCresswell/jimcresswell.net/issues"
  },
  "keywords": [
    "personal-website",
    "cv",
    "nextjs",
    "react",
    "tailwindcss"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "clean": "rm -rf .next coverage",
    "build": "next build && tsx scripts/generate-pdf.ts",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=default",
    "test:ui": "playwright test --ui",
    "e2e:server": "node --import tsx scripts/e2e-web-server.ts",
    "visual-regression:harness": "tsx scripts/run-visual-regression-harness.ts",
    "generate:icons": "tsx logo/generate-icons.ts",
    "logo:statusline": "tsx scripts/statusline-logo-glyphs.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "accept-md-runtime": "5.0.2",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "commander": "^14.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "fontkit": "^2.0.4",
    "jsdom": "^30.0.1",
    "pino": "^10.3.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.6.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "7.3.5",
    "vitest": "^5.0.1"
  }
}
