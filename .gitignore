# Root ignore rules for the jimcresswell.net monorepo. Workspace-local rules
# live beside each workspace (jcdotnet/.gitignore); root-level tools read this
# file, so anything they must skip is mirrored here.

# Turbo cache
.turbo
tc-profile.json
lint-profile.json

# Built files
dist
**/dist

# Local MCP server config
.mcp.json

# Repo-scoped tool binaries: .agent/setup/install-shellcheck.sh installs the
# pinned shellcheck here, and the lint:shell gate runs it before any on PATH.
# No trailing slash, so a `.tools` symlink is ignored too.
.tools

# Merge bot: per-checkout and never tracked (the tracked surface is the
# .example template beside it; see .agent/reference/merge-bot.md).
.github/merge-bot.json

# Platform settings: project config is tracked, local overrides are not.
.claude/settings.local.json
.cursor/settings.local.json
.gemini/settings.local.json
.claude/logs/
.claude/scheduled_tasks.lock

# Generated docs and type declarations
**/docs/api
**/.typedoc
**/*.d.ts
**/*.d.ts.map
!jcdotnet/next-env.d.ts

# File system artefacts
.DS_Store
.AppleDouble
.LSOverride
._*
[Dd]esktop.ini
Thumbs.db

# Agent worktrees nested in the checkout (owner ruling 2026-09-30): every
# lane lives under .claude/worktrees/<lane>, ignored here and by every root
# check tool; only the placeholder .gitignore inside it is tracked (the
# contents pattern, not the directory: git cannot re-include a file under an
# ignored directory).
.claude/worktrees/**/*
!.claude/worktrees/.gitignore

# Local reference files, not for source control
.agent/reference-local/**/*
!.agent/reference-local/.gitignore

# Isolated local notes: an ignored compatibility boundary (privacy.md), never source-controlled.
.agent/private/

# Operator profile: moved to ~/.practice/profile/ (PDR-141); the two stubs are tracked and
# point there, and a file placed here by an older habit stays untracked.
.agent/operator-local/**/*
!.agent/operator-local/.gitignore
!.agent/operator-local/README.md

# Logs
*.log
.logs/*
!.logs/.gitignore
logs/
*.har
!.agent/memory/operational/diagnostics/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
.tmp/
logs_result.json

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Test result files
**/test-results/
**/test-artifacts/
**/test-cache/
**/playwright-report/
**/blob-report/
**/regression-artifacts/
**/reports/
!.agent/reports/
**/temp-secrets/
**/coverage/
**/*.lcov
.nyc_output

# Dependency directories
node_modules/
**/node_modules/

# TypeScript cache
*.tsbuildinfo

# Caches
.npm
.pnpm-store/
.eslintcache
.stylelintcache
.cache
.cache/

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
env.vercel.local
!.env.example

# Next.js build output
.next
out
build
# The corpus-analysis workflow build sources are not build output (closure item 4, row 3).
!agent-tools/src/corpus-analysis/workflows/build/
# The restatement-audit workflow build sources the same (received from OCE in the code landing).
!agent-tools/src/restatement-audit/workflows/build/

# Vercel
.vercel

# Vite timestamp files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Agent state: machine-local coordination surfaces are untracked; scaffolding
# and durable decision provenance (conversations/, escalations/, sidebars/) are
# tracked. Per-directory .gitignore under .agent/state/ draws the fine line.
.agent/state/onboarding/
.agent/state/collaboration/owner-jobs.md
.agent/state/collaboration/comms-seen/
.agent/state/*credentials*.json
.agent/state/*.credentials.json

# Cursor composer identity mirror (machine-local)
.cursor/practice-composer-session.local.json
