    {
      "@type": "EmployeeRole",
      "@id": "https://www.jimcresswell.net/cv/#role-oak-principal-2022-present",
      "roleName": "Principal Engineer",
      "worksFor": { "@id": "https://www.jimcresswell.net/#org-oak" },
      "startDate": "2022-06",
      "description": "Setting foundational technical and product direction inside a live national public service. Conceived and built an SDK and MCP server for Oak\u2019s fully sequenced, pedagogically rigorous curriculum data, released under the Open Government Licence and directly accessible to AI-powered services. Helped shape the Engineering function from four contractors into five product squads and three platform groups."
    },

    {
      "@type": "EmployeeRole",
      "@id": "https://www.jimcresswell.net/cv/#role-oak-devops-2021-2022",
      "roleName": "Head of DevOps and Quality (Consulting)",
      "worksFor": { "@id": "https://www.jimcresswell.net/#org-oak" },
      "startDate": "2021-01",
      "endDate": "2022-06",
      "description": "Set delivery infrastructure and quality culture during rapid growth from startup to national platform. Established CI/CD, testing strategy, and developer experience foundations that supported the transition to permanent engineering teams."
    },

