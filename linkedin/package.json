{
  "name": "linkedin",
  "version": "0.0.1",
  "private": true,
  "description": "LinkedIn drafts: the profile copy, its structure validator and its local editor",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo",
    "editor": "pnpm --silent build && tsx src/editor/serve.ts",
    "lint": "eslint --max-warnings 0 . && pnpm --silent validate-profile",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-profile": "tsx src/check/validate-profile.ts profile.md"
  },
  "dependencies": {
    "@engraph/result": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@engraph/eslint-plugin-standards": "workspace:*",
    "@engraph/workspace-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
