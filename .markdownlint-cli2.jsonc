// markdownlint-cli2 configuration — the ownership footprint (`ignores`).
// Rules live in `.markdownlint.json` (auto-read by cli2 as the `config` object).
//
// The universe is the tracked tree, computed by `repo-check markdownlint-tracked`
// from `git ls-files` and passed with `--no-globs`; this file never declares
// what exists (a disk walk lints whatever the machine carries and proves the
// machine, not the repository). It declares only ownership: which tracked
// surfaces markdownlint does not govern. Canon surfaces lint by default;
// reference, archive, live-channel and generated material is excluded. Moving
// a folder in or out of `ignores` is a deliberate governance act
// (`.agent/rules/no-warning-toleration.md`).
//
// Never add an `ignores` entry beginning with `!` or `#`: in cli2 v0.22.x such
// an entry silently zeroes the run to a false green.
{
  "ignores": [
    ".agent/collaboration/rapid-comms/2026-*.md",
    ".agent/evaluations/**",
    ".agent/experience/**",
    ".agent/hooks/**",
    ".agent/plans-legacy-2026-09/**",
    ".agent/prompts/**",
    ".agent/reference/**",
    ".agent/reference-local/**",
    ".agent/reports/**",
    ".agent/state/pr-lifecycle/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".agents/**",
    "**/CHANGELOG.md",
  ],
}
