{
  "name": "@engraph/eslint-plugin-standards",
  "version": "1.0.0",
  "private": true,
  "description": "Custom ESLint rules for architectural boundary enforcement and code standards",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "eslint": "^10.11.0",
    "typescript": "^6"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-tsdoc": "^0.5.3",
    "eslint-plugin-unicorn": "^76.0.0",
    "minimatch": "^10.2.6",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@engraph/workspace-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.lint.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimCresswell/jimcresswell.net.git",
    "directory": "tooling/eslint"
  },
  "bugs": {
    "url": "https://github.com/jimCresswell/jimcresswell.net/issues"
  },
  "homepage": "https://github.com/jimCresswell/jimcresswell.net/tree/main/tooling/eslint#readme",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "architecture",
    "boundaries"
  ],
  "author": {
    "name": "Jim Cresswell",
    "email": "contact@jimcresswell.net",
    "url": "https://jimcresswell.net"
  },
  "license": "MIT"
}
