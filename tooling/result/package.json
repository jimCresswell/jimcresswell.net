{
  "name": "@engraph/result",
  "version": "0.0.0-development",
  "private": true,
  "description": "Result<T, E> type for explicit error handling without exceptions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/*.test.ts",
    "!**/*.integration.test.ts"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@engraph/eslint-plugin-standards": "workspace:*",
    "@engraph/workspace-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "globals": "^17.9.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimCresswell/jimcresswell.net.git",
    "directory": "tooling/result"
  },
  "bugs": {
    "url": "https://github.com/jimCresswell/jimcresswell.net/issues"
  },
  "homepage": "https://github.com/jimCresswell/jimcresswell.net/tree/main/tooling/result#readme",
  "keywords": [
    "result",
    "error-handling",
    "functional",
    "typescript"
  ],
  "author": {
    "name": "Jim Cresswell",
    "email": "contact@jimcresswell.net",
    "url": "https://jimcresswell.net"
  },
  "license": "MIT"
}
