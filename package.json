{
  "name": "@jimcresswell/www",
  "version": "1.1.0",
  "description": "Jim Cresswell's personal website",
  "author": {
    "name": "Jim Cresswell",
    "url": "https://www.jimcresswell.net",
    "email": "contact@jimcresswell.net"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "homepage": "https://www.jimcresswell.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/jimCresswell/jimcresswell.net.git"
  },
  "bugs": {
    "url": "https://github.com/jimCresswell/jimcresswell.net/issues"
  },
  "keywords": [
    "personal-website",
    "cv",
    "nextjs",
    "react",
    "tailwindcss"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "clean": "rm -rf .next coverage",
    "build": "next build && tsx scripts/generate-pdf.ts",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "markdownlint:check": "markdownlint-cli2 --formatter pretty",
    "markdownlint:fix": "markdownlint-cli2 --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:ui": "playwright test --ui",
    "fix": "pnpm format:fix && pnpm markdownlint:fix && pnpm lint:fix",
    "check:fix": "pnpm format:fix && pnpm markdownlint:fix && pnpm lint:fix && pnpm typecheck && pnpm test && pnpm knip && pnpm secrets:scan && pnpm vital-surfaces:check && pnpm portability:check && pnpm subagents:check",
    "check": "pnpm check:fix",
    "check:ci": "pnpm format && pnpm markdownlint:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm secrets:scan && pnpm vital-surfaces:check && pnpm portability:check && pnpm subagents:check",
    "secrets:scan": "gitleaks git --redact --verbose",
    "test:e2e": "playwright test --project=default",
    "visual-regression-harness": "tsx scripts/run-visual-regression-harness.ts",
    "knip": "knip",
    "portability:check": "node scripts/validate-portability.mjs",
    "subagents:check": "node scripts/validate-subagents.mjs",
    "vital-surfaces:check": "node scripts/validate-vital-surfaces.mjs",
    "practice:fitness": "node scripts/validate-practice-fitness.mjs",
    "practice:fitness:informational": "node scripts/validate-practice-fitness.mjs --informational",
    "fitness-vocabulary:check": "node scripts/validate-fitness-vocabulary.mjs",
    "generate:icons": "tsx logo/generate-icons.ts",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "accept-md-runtime": "5.0.2",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "commander": "^14.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "fontkit": "^2.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-cli2-formatter-pretty": "^0.0.10",
    "pino": "^10.3.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.6.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "smol-toml": "1.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "7.3.5",
    "vitest": "^4.1.10"
  },
  "knip": {
    "ignore": [
      "accept-md.config.js"
    ],
    "ignoreDependencies": [
      "markdownlint-cli2-formatter-pretty"
    ],
    "ignoreBinaries": [
      "gitleaks",
      "ldd"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "esbuild": "0.28.2",
      "vite": "7.3.5"
    },
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  }
}
