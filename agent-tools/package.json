{
  "name": "@engraph/agent-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript tooling workspace for agent operational CLIs",
  "scripts": {
    "clean": "rm -rf dist .turbo",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 . --fix",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts && pnpm --silent build && node dist/src/bin/run-smoke-tests.js",
    "smoke:merge-bot-push-output": "tsx smoke-tests/merge-bot-push-output.smoke.ts",
    "smoke:esm-import-extensions": "tsx smoke-tests/esm-import-extensions.smoke.ts",
    "smoke:commit-queue-registry": "tsx smoke-tests/commit-queue-registry.smoke.ts",
    "smoke:commit-queue-store": "tsx smoke-tests/commit-queue-store.smoke.ts",
    "smoke:codex-session-alert-bootstrap": "pnpm --silent build && tsx smoke-tests/codex-session-alert-bootstrap.smoke.ts",
    "smoke:pre-tool-use-dispatch": "tsx smoke-tests/pre-tool-use-dispatch.smoke.ts",
    "smoke:install-version-guard": "tsx smoke-tests/install-version-guard.smoke.ts",
    "smoke:commit-queue-worktree": "pnpm --silent build && tsx smoke-tests/commit-queue-worktree.smoke.ts",
